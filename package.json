{
  "name": "riclaw",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram-to-Vercel autonomous app builder orchestrator scaffold for Raspberry Pi.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/app/server.ts",
    "start": "node dist/app/server.js",
    "poll:telegram": "tsx src/app/pollTelegram.ts",
    "telegram:set-webhook": "tsx src/app/registerTelegramWebhook.ts",
    "telegram:delete-webhook": "tsx src/app/deleteTelegramWebhook.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@openai/codex": "^0.125.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
